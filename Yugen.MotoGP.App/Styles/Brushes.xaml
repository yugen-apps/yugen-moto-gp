<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ListItemBackgroundBrush"
                     Color="{ThemeResource ListItemBackgroundColor}" />
    <LinearGradientBrush x:Key="ListItemBackgroundTransitionBrush"
                         StartPoint="0,1"
                         EndPoint="1,1">
        <GradientStop Color="{ThemeResource ListItemTransparentBackgroundColor}"
                      Offset="0" />
        <GradientStop Color="{ThemeResource ListItemBackgroundColor}"
                      Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>