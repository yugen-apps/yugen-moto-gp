<Page x:Class="Yugen.MotoGP.App.Views.WorldStandingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:observableobjects="using:Yugen.MotoGP.App.ObservableObjects"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <Page.Resources>
        <x:Double x:Key="MainColumnMinWidth">300</x:Double>
        <x:Double x:Key="StatColumnMinWidth">160</x:Double>
    </Page.Resources>

    <Grid>

        <ListView ItemsSource="{x:Bind ViewModel.StandingList, Mode=OneWay}"
                  ItemContainerStyleSelector="{StaticResource GPAlternateBackgroundListViewStyleSelector}">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                            <ColumnDefinition MinWidth="{StaticResource StatColumnMinWidth}" />
                            <ColumnDefinition MinWidth="{StaticResource StatColumnMinWidth}" />
                            <ColumnDefinition MinWidth="{StaticResource StatColumnMinWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="P"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}" />

                        <Grid Grid.Column="1"
                              Padding="8,0,16,0">
                            <TextBlock Text="NAME"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       TextAlignment="Left" />
                            <TextBlock Text="#"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="COUNTRY" />

                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="POINTS" />

                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="TEAM" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="observableobjects:ClassificationObservableObject">
                    <Grid MinHeight="48">

                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                            <ColumnDefinition MinWidth="{StaticResource StatColumnMinWidth}" />
                            <ColumnDefinition MinWidth="{StaticResource StatColumnMinWidth}" />
                            <ColumnDefinition MinWidth="{StaticResource StatColumnMinWidth}" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource GPBackgroundColor1}"
                                Margin="4"
                                CornerRadius="8"
                                Width="32"
                                Height="32">
                            <TextBlock TextAlignment="Center"
                                       Foreground="{ThemeResource GPForegroundColor4}"
                                       FontWeight="Bold"
                                       Text="{x:Bind Position}" />
                        </Border>

                        <Grid Grid.Column="1"
                              Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{ThemeResource GPSubtitleTextBlock}"
                                       Text="{x:Bind FullName}"
                                       VerticalAlignment="Center">
                            </TextBlock>

                            <Border Grid.Column="1"
                                    MinWidth="32"
                                    Height="32"
                                    Padding="2"
                                    Background="#25000000"
                                    VerticalAlignment="Center"
                                    CornerRadius="2">
                                <TextBlock Text="{x:Bind Number}"
                                           Style="{StaticResource GPDataGridStatTextBlock}"
                                           Foreground="{ThemeResource GPForegroundColor3}"
                                           FontSize="18"
                                           TextAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Style="{ThemeResource GPDataGridStatTextBlock}"
                                   Text="{x:Bind Country}" />

                        <TextBlock Grid.Column="3"
                                   Style="{ThemeResource GPDataGridHighlightStatTextBlock}"
                                   Text="{x:Bind Points}" />

                        <TextBlock Grid.Column="4"
                                   Style="{ThemeResource GPDataGridStatTextBlock}"
                                   Text="{x:Bind TeamName}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>