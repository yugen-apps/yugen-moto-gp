<Page x:Class="Yugen.MotoGP.App.Views.WorldStandingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Yugen.MotoGP.App.Models.WorldStanding"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>

        <ListView ItemsSource="{x:Bind ViewModel.WorldStanding.Classification, Mode=OneWay}">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Padding="2"
                                   Text="P" />

                        <TextBlock Grid.Column="1"
                                   Padding="2"
                                   Text="Number" />

                        <TextBlock Grid.Column="2"
                                   Padding="2"
                                   Text="FullName" />

                        <TextBlock Grid.Column="3"
                                   Padding="2"
                                   Text="Points" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Classification">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Padding="2"
                                   Text="{x:Bind Position}" />

                        <TextBlock Grid.Column="1"
                                   Padding="2"
                                   Text="{x:Bind Rider.Number}" />

                        <TextBlock Grid.Column="2"
                                   Padding="2"
                                   Text="{x:Bind Rider.FullName}" />

                        <TextBlock Grid.Column="3"
                                   Padding="2"
                                   Text="{x:Bind Points}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>