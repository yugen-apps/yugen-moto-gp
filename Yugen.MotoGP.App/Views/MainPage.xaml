<Page x:Class="Yugen.MotoGP.App.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Yugen.MotoGP.App.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Yugen.MotoGP.App.Models"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <StandardUICommand x:Name="GoToLiveTimingXamlUICommand"
                           Command="{x:Bind ViewModel.GoToLiveTimingCommand}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Calendar.events, Mode=OneWay}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="Name" />

                            <TextBlock Grid.Column="1"
                                       Padding="2"
                                       Text="Date Start" />

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="Country" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Event">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="{x:Bind name}" />

                            <TextBlock Grid.Column="1"
                                       Padding="2"
                                       Text="{x:Bind date_start}" />

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="{x:Bind country}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1">
            <ListView ItemsSource="{x:Bind ViewModel.RiderCollection, Mode=OneWay}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="P" />

                            <TextBlock Grid.Column="1"
                                       Padding="2"
                                       Text="Name" />

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="Last Lap Time" />

                            <TextBlock Grid.Column="3"
                                       Padding="2"
                                       Text="Gap F." />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Rider">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="{x:Bind pos}" />

                            <TextBlock Grid.Column="1">
                                <Run Text="{x:Bind rider_name}" />
                                <Run Text=" " />
                                <Run Text="{x:Bind rider_surname}" />
                            </TextBlock>

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="{x:Bind last_lap_time}" />

                            <TextBlock Grid.Column="3"
                                       Padding="2"
                                       Text="{x:Bind gap_first}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</Page>
