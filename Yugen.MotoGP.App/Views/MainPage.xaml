<Page x:Class="Yugen.MotoGP.App.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:toolkitConverters="using:CommunityToolkit.WinUI.UI.Converters"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:converters="using:Yugen.MotoGP.App.Converters"
      xmlns:observableobjects="using:Yugen.MotoGP.App.ObservableObjects"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <Page.Resources>
        <x:Double x:Key="MainColumnMinWidth">300</x:Double>
        <x:Double x:Key="StatColumnMaxWidth">160</x:Double>
        <converters:LiveStatusToVisibilityConverter x:Key="LiveStatusToVisibilityConverter" />
        <converters:ResultsStatusToVisibilityConverter x:Key="ResultsStatusToVisibilityConverter" />
        <toolkitConverters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"
                                                     TrueValue="Collapsed"
                                                     FalseValue="Visible" />
        <StandardUICommand x:Name="GoToLiveTimingXamlUICommand"
                           Command="{x:Bind ViewModel.GoToLiveTimingCommand}" />
        <StandardUICommand x:Name="GoToClassificationXamlUICommand"
                           Command="{x:Bind ViewModel.GoToClassificationCommand}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}">
                <ListView.Header>
                    <StackPanel Orientation="Horizontal"
                                Padding="24,14"
                                Margin="16,0"
                                Spacing="8">
                        <FontIcon Glyph=""
                                  FontSize="24" />
                        <TextBlock Text="CALENDAR"
                                   FontSize="24"
                                   FontFamily="{StaticResource KanitFontFamily}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="observableobjects:EventObservableObject">
                        <Grid Margin="4"
                              CornerRadius="4"
                              Background="{ThemeResource GPBackgroundColor3}"
                              MaxHeight="96">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".2*" />
                                <ColumnDefinition Width=".5*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.ColumnSpan="2"
                                   Opacity=".3"
                                   Source="{x:Bind CardSource, Mode=OneWay}"
                                   Stretch="UniformToFill" />

                            <Border Background="#44000000"
                                    CornerRadius="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="8">
                                <StackPanel Orientation="Vertical"
                                            Spacing="4">
                                    <TextBlock Text="{x:Bind StartDay}"
                                               Style="{ThemeResource GPCaptionTextBlock}"
                                               HorizontalAlignment="Center" />
                                    <Rectangle Height="1"
                                               Fill="White" />
                                    <TextBlock Text="{x:Bind StartMonth}"
                                               Style="{ThemeResource GPCaptionTextBlock}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Rectangle Grid.Column="1"
                                       HorizontalAlignment="Stretch"
                                       Fill="{ThemeResource ListItemBackgroundTransitionBrush}" />

                            <StackPanel Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        VerticalAlignment="Center">

                                <TextBlock Padding="2"
                                           Style="{ThemeResource GPTitleTextBlock}"
                                           Text="{x:Bind Name}"
                                           FontSize="24" />

                                <TextBlock Padding="2"
                                           VerticalAlignment="Center"
                                           Style="{ThemeResource GPCaptionTextBlock}"
                                           Foreground="{ThemeResource GPForegroundColor3}">
                                    <Run Text="{x:Bind CircuitCountry}" />
                                    <Run Text=" | " />
                                    <Run Text="{x:Bind CircuitName}" />
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Padding="2"
                                    Margin="8"
                                    MinWidth="120"
                                    Command="{StaticResource GoToLiveTimingXamlUICommand}"
                                    VerticalAlignment="Bottom"
                                    Visibility="{x:Bind Status, Mode=OneWay, Converter={StaticResource LiveStatusToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="8,4">
                                    <Ellipse Width="12"
                                             Height="12"
                                             Fill="Red"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Padding="2"
                                    Margin="8"
                                    MinWidth="120"
                                    Command="{StaticResource GoToClassificationXamlUICommand}"
                                    CommandParameter="{x:Bind Id}"
                                    VerticalAlignment="Bottom"
                                    Visibility="{x:Bind Status, Mode=OneWay, Converter={StaticResource ResultsStatusToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="8,4">
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Visibility="{x:Bind ViewModel.IsCalendarLoading, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsCalendarLoading, Mode=OneWay}"
                              Height="48"
                              Width="48" />
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">

                    <TextBlock Margin="4"
                               Foreground="{StaticResource GPForegroundColor2}"
                               FontSize="24"
                               FontFamily="{StaticResource KanitFontFamily}"
                               FontWeight="Bold"
                               Text="{x:Bind ViewModel.Head.EventTvName, Mode=OneWay}" />

                    <Border Background="{ThemeResource GPBackgroundColor1}"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Padding="8">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextLineBounds="Tight"
                                   Foreground="{ThemeResource GPForegroundColor4}"
                                   Style="{ThemeResource GPCaptionTextBlock}"
                                   Text="{x:Bind ViewModel.Head.Category, Mode=OneWay}" />
                    </Border>

                    <FontIcon FontFamily="{StaticResource FontAwesomeFontFamily}"
                              FontSize="24"
                              Glyph="&#xF11E;"
                              Visibility="{x:Bind ViewModel.IsFinished, Mode=OneWay}" />
                </StackPanel>

                <Grid Grid.Column="1"
                      HorizontalAlignment="Right"
                      Visibility="{x:Bind ViewModel.IsFinished, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                    <TextBlock Margin="4"
                               Foreground="{StaticResource GPForegroundColor2}"
                               FontSize="24"
                               FontFamily="{StaticResource KanitFontFamily}"
                               FontWeight="Bold">

                        <Run Text="{x:Bind ViewModel.Head.SessionStatusName, Mode=OneWay}" />
                        <Run Text="{x:Bind ViewModel.Head.Remaining, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Grid>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.RiderCollection, Mode=OneWay}"
                      ItemContainerStyleSelector="{StaticResource GPAlternateBackgroundListViewStyleSelector}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                                <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                                <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="P"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}" />

                            <Grid Grid.Column="1"
                                  Padding="8,0,16,0">
                                <TextBlock Text="NAME"
                                           Style="{StaticResource GPDataGridHeaderTextBlock}"
                                           TextAlignment="Left" />
                                <TextBlock Text="#"
                                           Style="{StaticResource GPDataGridHeaderTextBlock}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       Text="LAP" />

                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       Text="GAP" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="observableobjects:RiderDetailsObservableObject">
                        <Grid MinHeight="48">

                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </Grid.Resources>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                                <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                                <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{ThemeResource GPBackgroundColor1}"
                                    Margin="4"
                                    CornerRadius="8"
                                    Width="32"
                                    Height="32">
                                <TextBlock TextAlignment="Center"
                                           Foreground="{ThemeResource GPForegroundColor4}"
                                           FontWeight="Bold"
                                           Text="{x:Bind Position}" />
                            </Border>

                            <Grid Grid.Column="1"
                                  Padding="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Height="Auto"
                                      Width="4"
                                      Margin="0,8,8,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Rectangle Fill="Gray" />
                                    <Rectangle Grid.Row="1"
                                               Fill="LightGray" />
                                </Grid>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Style="{ThemeResource GPSubtitleTextBlock}">
                                <Run Text="{x:Bind Name}" />
                                <Run Text="{x:Bind Surname}"
                                     FontWeight="SemiBold" />
                                </TextBlock>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Padding="2">
                                    <Border MinWidth="32"
                                            Height="32"
                                            Background="#25000000"
                                            VerticalAlignment="Center"
                                            CornerRadius="2">
                                        <TextBlock Text="{x:Bind Number}"
                                                   Style="{StaticResource GPDataGridStatTextBlock}"
                                                   Foreground="{ThemeResource GPForegroundColor3}"
                                                   FontSize="18"
                                                   TextAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="2"
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                <TextBlock Style="{StaticResource GPDataGridStatTextBlock}"
                                           Text="{x:Bind LastLapTime}" />
                            </Border>

                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource GPDataGridStatTextBlock}"
                                       Text="{x:Bind GapFirst}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>