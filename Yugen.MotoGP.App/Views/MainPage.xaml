<Page x:Class="Yugen.MotoGP.App.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models2="using:Yugen.MotoGP.App.Models.Calendar"
      xmlns:models1="using:Yugen.MotoGP.App.Models.LiveTiming"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <StandardUICommand x:Name="GoToLiveTimingXamlUICommand"
                           Command="{x:Bind ViewModel.GoToLiveTimingCommand}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Calendar.Events, Mode=OneWay}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="Name" />

                            <TextBlock Grid.Column="1"
                                       Padding="2"
                                       Text="Date Start" />

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="Country" />

                            <TextBlock Grid.Column="3"
                                       Padding="2"
                                       Text="Live Timing" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models2:Event">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="{x:Bind Name}" />

                            <TextBlock Grid.Column="1"
                                       Padding="2"
                                       Text="{x:Bind DateStart}" />

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="{x:Bind Country}" />

                            <Button Grid.Column="3"
                                    Padding="2"
                                    Content="Live Timing"
                                    Command="{StaticResource GoToLiveTimingXamlUICommand}"
                                    CommandParameter="{x:Bind EventCategories[0].TimingId}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1">
            <ListView ItemsSource="{x:Bind ViewModel.RiderCollection, Mode=OneWay}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="P" />

                            <TextBlock Grid.Column="1"
                                       Padding="2"
                                       Text="Name" />

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="Last Lap Time" />

                            <TextBlock Grid.Column="3"
                                       Padding="2"
                                       Text="Gap F." />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models1:RiderDetails">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Padding="2"
                                       Text="{x:Bind Pos}" />

                            <TextBlock Grid.Column="1">
                                <Run Text="{x:Bind RiderName}" />
                                <Run Text=" " />
                                <Run Text="{x:Bind RiderSurname}" />
                            </TextBlock>

                            <TextBlock Grid.Column="2"
                                       Padding="2"
                                       Text="{x:Bind LastLapTime}" />

                            <TextBlock Grid.Column="3"
                                       Padding="2"
                                       Text="{x:Bind GapFirst}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>