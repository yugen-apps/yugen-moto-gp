<Page x:Class="Yugen.MotoGP.App.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:observableobjects="using:Yugen.MotoGP.App.ObservableObjects"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  MaxWidth="1800">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="observableobjects:EventObservableObject">
                    <Grid CornerRadius="8"
                          Background="{ThemeResource ListItemBackgroundColor}"
                          Margin="8"
                          MaxHeight="250">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Image Source="{x:Bind CardSource, Mode=OneWay}"
                                   Stretch="UniformToFill" />

                            <Border Background="#99000000"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="8">
                                <StackPanel Orientation="Vertical"
                                            Spacing="4">
                                    <TextBlock Text="{x:Bind StartDay}"
                                               Style="{ThemeResource GPCaptionTextBlock}"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="20" />
                                    <Rectangle Height="1"
                                               Fill="White" />
                                    <TextBlock Text="{x:Bind StartMonth}"
                                               Style="{ThemeResource GPCaptionTextBlock}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Rectangle Width="120"
                                       HorizontalAlignment="Right"
                                       Fill="{ThemeResource ListItemBackgroundTransitionBrush}" />
                        </Grid>

                        <Grid Grid.Column="1"
                              Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Padding="2"
                                       Text="{x:Bind StartDate}"
                                       Style="{ThemeResource GPCaptionTextBlock}" />
                            <!--<TextBlock Padding="2"
                                       Text="{x:Bind date_end}" />-->

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Image Height="40"
                                       Width="40"
                                       Source="{x:Bind FlagPath}" />

                                <TextBlock Padding="2"
                                           VerticalAlignment="Center"
                                           Style="{ThemeResource GPSubtitleTextBlock}">
                                    <Run Text="{x:Bind CircuitCountry}"
                                         FontWeight="SemiBold" />
                                    <Run Text=" | " />
                                    <Run Text="{x:Bind CircuitName}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Padding="2"
                                       Style="{ThemeResource GPTitleTextBlock}"
                                       Text="{x:Bind Name}" />

                            <TextBlock Grid.Row="3"
                                       Padding="2"
                                       Text="{x:Bind Hashtag}"
                                       Style="{ThemeResource GPCaptionTextBlock}"
                                       Foreground="{ThemeResource GPForegroundColor3}" />

                            <!--<TextBlock Grid.Row="4"
                                       Padding="2"
                                       Text="{x:Bind event_categories[0].timing_id}" />-->
                        </Grid>

                        <Border Grid.Column="1"
                                Background="{ThemeResource GPBackgroundColor1}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                CornerRadius="0,0,0,16"
                                Height="40"
                                Width="100">
                            <TextBlock Padding="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource GPForegroundColor4}"
                                       Style="{ThemeResource GPSubtitleTextBlock}"
                                       Text="{x:Bind Kind}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>