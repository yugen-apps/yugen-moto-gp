<Page x:Class="Yugen.MotoGP.App.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Yugen.MotoGP.App.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Yugen.MotoGP.App.Models"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Calendar.events, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Event">
                    <Grid CornerRadius="{ThemeResource ControlCornerRadius}"
                          Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Image Source="{x:Bind assets[0].path}" />

                            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Height="40"
                                    Width="40">
                                <TextBlock Text="{x:Bind date_start}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Padding="2"
                                       Text="{x:Bind date_start}" />
                            <!--<TextBlock Padding="2"
                                       Text="{x:Bind date_end}" />-->
                            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                    CornerRadius="8"
                                    HorizontalAlignment="Right"
                                    Margin="8"
                                    Height="40"
                                    Width="40">
                                <TextBlock Padding="2"
                                           Text="{x:Bind kind}" />
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal">
                                <Image Source="{x:Bind assets[3].path}"
                                       Height="40"
                                       Width="40" />
                                <TextBlock Padding="2"
                                           Style="{ThemeResource SubtitleTextBlockStyle}"
                                           Text="{x:Bind circuit.name}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Padding="2"
                                       Style="{ThemeResource TitleTextBlockStyle}"
                                       Text="{x:Bind name}" />

                            <TextBlock Grid.Row="3"
                                       Padding="2"
                                       Text="{x:Bind hashtag}" />

                            <!--<TextBlock Grid.Row="4"
                                       Padding="2"
                                       Text="{x:Bind event_categories[0].timing_id}" />-->
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
