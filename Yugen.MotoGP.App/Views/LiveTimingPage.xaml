<Page x:Class="Yugen.MotoGP.App.Views.LiveTimingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:observableobjects="using:Yugen.MotoGP.App.ObservableObjects"
      xmlns:toolkitConverters="using:CommunityToolkit.WinUI.UI.Converters"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <x:Double x:Key="MainColumnMinWidth">300</x:Double>
        <x:Double x:Key="StatColumnMaxWidth">160</x:Double>
        <toolkitConverters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"
                                                     TrueValue="Collapsed"
                                                     FalseValue="Visible" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">

                <TextBlock Margin="4"
                           Foreground="{StaticResource GPForegroundColor2}"
                           FontSize="24"
                           FontFamily="{StaticResource KanitFontFamily}"
                           FontWeight="Bold"
                           Text="{x:Bind ViewModel.Head.EventTvName, Mode=OneWay}" />

                <Border Background="{ThemeResource GPBackgroundColor1}"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Padding="8">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextLineBounds="Tight"
                               Foreground="{ThemeResource GPForegroundColor4}"
                               Style="{ThemeResource GPCaptionTextBlock}"
                               Text="{x:Bind ViewModel.Head.Category, Mode=OneWay}" />
                </Border>

                <FontIcon FontFamily="{StaticResource FontAwesomeFontFamily}"
                          FontSize="24"
                          Glyph="&#xF11E;"
                          Visibility="{x:Bind ViewModel.IsFinished, Mode=OneWay}" />

            </StackPanel>

            <Grid Grid.Column="1"
                  HorizontalAlignment="Right"
                  Visibility="{x:Bind ViewModel.IsFinished, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <TextBlock Margin="4"
                           Foreground="{StaticResource GPForegroundColor2}"
                           FontSize="24"
                           FontFamily="{StaticResource KanitFontFamily}"
                           FontWeight="Bold">
                        
                        <Run Text="{x:Bind ViewModel.Head.SessionStatusName, Mode=OneWay}" />
                        <Run Text="{x:Bind ViewModel.Head.Remaining, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.RiderCollection, Mode=OneWay}"
                  ItemContainerStyleSelector="{StaticResource GPAlternateBackgroundListViewStyleSelector}">

            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="P"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}" />

                        <Grid Grid.Column="1"
                              Padding="8,0,16,0">
                            <TextBlock Text="NAME"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       TextAlignment="Left" />
                            <TextBlock Text="#"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="LAST LAP TIME" />

                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="BEST LAP TIME" />

                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="LAP" />

                        <TextBlock Grid.Column="5"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="GAP P." />

                        <TextBlock Grid.Column="6"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="GAP F." />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="observableobjects:RiderDetailsObservableObject">
                    <Grid MinHeight="48">

                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource GPBackgroundColor1}"
                                Margin="4"
                                CornerRadius="8"
                                Width="32"
                                Height="32">
                            <TextBlock TextAlignment="Center"
                                       Foreground="{ThemeResource GPForegroundColor4}"
                                       FontWeight="Bold"
                                       Text="{x:Bind Position}" />
                        </Border>

                        <Grid Grid.Column="1"
                              Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Height="Auto"
                                  Width="4"
                                  Margin="0,8,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Rectangle Fill="Gray" />
                                <Rectangle Grid.Row="1"
                                           Fill="LightGray" />
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource GPSubtitleTextBlock}">
                                <Run Text="{x:Bind Name}" />
                                <Run Text="{x:Bind Surname}"
                                     FontWeight="SemiBold" />
                            </TextBlock>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Padding="2">
                                <TextBlock Text="{x:Bind OnPit}"
                                           Foreground="LightGoldenrodYellow" />
                                <Border MinWidth="32"
                                        Height="32"
                                        Background="#25000000"
                                        VerticalAlignment="Center"
                                        CornerRadius="2">
                                    <TextBlock Text="{x:Bind Number}"
                                               Style="{StaticResource GPDataGridStatTextBlock}"
                                               Foreground="{ThemeResource GPForegroundColor3}"
                                               FontSize="18"
                                               TextAlignment="Center" />
                                </Border>

                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="2"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Style="{StaticResource GPDataGridStatTextBlock}"
                                       Text="{x:Bind LastLapTime}" />
                        </Border>

                        <Border Grid.Column="3"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Style="{StaticResource GPDataGridHighlightStatTextBlock}"
                                       Text="{x:Bind LapTime}" />
                        </Border>

                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource GPDataGridStatTextBlock}">
                            <Run Text="{x:Bind NumLap}"
                                 FontSize="18" />
                            <Run Text="/" />
                            <Run Text="{x:Bind LastLap}"
                                 FontSize="12" />
                        </TextBlock>

                        <TextBlock Grid.Column="5"
                                   Style="{StaticResource GPDataGridStatTextBlock}"
                                   Text="{x:Bind GapPrev}" />

                        <TextBlock Grid.Column="6"
                                   Style="{StaticResource GPDataGridStatTextBlock}"
                                   Text="{x:Bind GapFirst}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>