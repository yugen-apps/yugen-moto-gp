<Page x:Class="Yugen.MotoGP.App.Views.LiveTimingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Yugen.MotoGP.App.Models.LiveTiming"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="4"
                       Text="{x:Bind ViewModel.Head.EventTvName, Mode=OneWay}" />

            <TextBlock Margin="4"
                       Text="{x:Bind ViewModel.Head.Remaining, Mode=OneWay}" />

            <TextBlock Margin="4"
                       Text="{x:Bind ViewModel.Head.Category, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.RiderCollection, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Padding="2"
                                   Text="P" />

                        <TextBlock Grid.Column="1"
                                   Padding="2"
                                   Text="Name" />

                        <TextBlock Grid.Column="2"
                                   Padding="2"
                                   Text="" />

                        <TextBlock Grid.Column="3"
                                   Padding="2"
                                   Text="#" />

                        <TextBlock Grid.Column="4"
                                   Padding="2"
                                   Text="Last Lap Time" />

                        <TextBlock Grid.Column="5"
                                   Padding="2"
                                   Text="Best Lap Time" />

                        <TextBlock Grid.Column="6"
                                   Padding="2"
                                   Text="Lap" />

                        <TextBlock Grid.Column="7"
                                   Padding="2"
                                   Text="Gap P." />

                        <TextBlock Grid.Column="8"
                                   Padding="2"
                                   Text="Gap F." />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RiderDetails">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Padding="2"
                                       Text="{x:Bind Pos}" />
                        </Border>

                        <TextBlock Grid.Column="1">
                            <Run Text="{x:Bind RiderName}" />
                            <Run Text=" " />
                            <Run Text="{x:Bind RiderSurname}" />
                        </TextBlock>

                        <TextBlock Grid.Column="2"
                                   Padding="2"
                                   Text="{x:Bind OnPit}" />

                        <Border Grid.Column="3"
                                Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                            <TextBlock Padding="2"
                                       Text="{x:Bind RiderNumber}" />
                        </Border>

                        <Border Grid.Column="4"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Padding="2"
                                       Text="{x:Bind LastLapTime}" />
                        </Border>

                        <Border Grid.Column="5"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Padding="2"
                                       Text="{x:Bind LapTime}" />
                        </Border>

                        <TextBlock Grid.Column="6">
                            <Run Text="{x:Bind NumLap}" />
                            <Run Text="/" />
                            <Run Text="{x:Bind LastLap}" />
                        </TextBlock>

                        <TextBlock Grid.Column="7"
                                   Padding="2"
                                   Text="{x:Bind GapPrev}" />

                        <TextBlock Grid.Column="8"
                                   Padding="2"
                                   Text="{x:Bind GapFirst}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>