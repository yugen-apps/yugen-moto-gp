<Page x:Class="Yugen.MotoGP.App.Views.LiveTimingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Yugen.MotoGP.App.Models.LiveTiming"
      xmlns:selectors="using:Yugen.MotoGP.App.Styles.Selectors"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <x:Double x:Key="MainColumnMinWidth">300</x:Double>
        <x:Double x:Key="StatColumnMaxWidth">160</x:Double>
        <selectors:AlternateBackgroundRiderDetailsStyleSelector x:Key="RiderDetailsStyleSelector"
                                                                Style1="{StaticResource RiderDetails1Style}"
                                                                Style2="{StaticResource RiderDetails2Style}">
            
        </selectors:AlternateBackgroundRiderDetailsStyleSelector>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Padding="24,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="4"
                           Foreground="{StaticResource GPForegroundColor2}"
                           FontSize="24"
                           FontFamily="{StaticResource KanitFontFamily}"
                           FontWeight="Bold">
                    <Run Text="{x:Bind ViewModel.Head.EventTvName, Mode=OneWay}" />
                    <Run Text="{x:Bind ViewModel.Head.Remaining, Mode=OneWay}" />
                    <Run Text="{x:Bind ViewModel.Head.Category, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.RiderCollection, Mode=OneWay}"
                  ItemContainerStyleSelector="{StaticResource RiderDetailsStyleSelector}">
            
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="P"
                                   Style="{StaticResource DataGridHeaderTextBlock}" />

                        <Grid Grid.Column="1"
                              Padding="8,0,16,0">
                            <TextBlock Text="NAME"
                                       Style="{StaticResource DataGridHeaderTextBlock}"
                                       TextAlignment="Left"/>
                            <TextBlock Text="#"
                                       Style="{StaticResource DataGridHeaderTextBlock}"
                                       HorizontalAlignment="Right" />   
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource DataGridHeaderTextBlock}"
                                   Text="LAST LAP TIME" />

                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource DataGridHeaderTextBlock}"
                                   Text="BEST LAP TIME" />

                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource DataGridHeaderTextBlock}"
                                   Text="LAP" />

                        <TextBlock Grid.Column="5"
                                   Style="{StaticResource DataGridHeaderTextBlock}"
                                   Text="GAP P." />

                        <TextBlock Grid.Column="6"
                                   Style="{StaticResource DataGridHeaderTextBlock}"
                                   Text="GAP F." />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RiderDetails">
                    <Grid MinHeight="48">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="FontFamily"
                                        Value="{StaticResource KanitFontFamily}" />
                            </Style>
                        </Grid.Resources>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource GPBackgroundColor1}" Margin="4" CornerRadius="4">
                            <TextBlock TextAlignment="Center"
                                       Foreground="{ThemeResource GPForegroundColor4}"
                                       FontWeight="Bold"
                                       Text="{x:Bind Pos}" />
                        </Border>

                        <Grid Grid.Column="1" Padding="8,0" >
                            <TextBlock FontSize="18" FontFamily="{StaticResource KanitFontFamily}">
                                <Run Text="{x:Bind RiderName}" />
                                <Run Text="{x:Bind RiderSurname}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Padding="2">
                                <TextBlock Text="{x:Bind OnPit}" Foreground="LightGoldenrodYellow"/>
                                <Border Width="32"
                                        Height="32"
                                        Background="#25000000"
                                        VerticalAlignment="Center" CornerRadius="2">
                                    <TextBlock Text="{x:Bind RiderNumber}"
                                               Foreground="{ThemeResource GPForegroundColor3}"
                                               FontSize="18"
                                               TextAlignment="Center"/>
                                </Border>

                            </StackPanel>
                        </Grid>
                       
                        <Border Grid.Column="2"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Style="{StaticResource DataGridStatTextBlock}"
                                       Text="{x:Bind LastLapTime}"/>
                        </Border>

                        <Border Grid.Column="3"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Style="{StaticResource DataGridStatTextBlock}"
                                       Text="{x:Bind LapTime}" Foreground="{ThemeResource GPForegroundColor2}"/>
                        </Border>

                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource DataGridStatTextBlock}">
                            <Run Text="{x:Bind NumLap}" FontSize="18" />
                            <Run Text="/" />
                            <Run Text="{x:Bind LastLap}" FontSize="12" />
                        </TextBlock>

                        <TextBlock Grid.Column="5"
                                   Style="{StaticResource DataGridStatTextBlock}"
                                   Text="{x:Bind GapPrev}" />

                        <TextBlock Grid.Column="6"
                                   Style="{StaticResource DataGridStatTextBlock}"
                                   Text="{x:Bind GapFirst}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>