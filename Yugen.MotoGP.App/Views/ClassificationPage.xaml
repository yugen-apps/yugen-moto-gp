<Page x:Class="Yugen.MotoGP.App.Views.ClassificationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
	  xmlns:models="using:Yugen.MotoGP.App.Models.Classifications"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <interactivity:Interaction.Behaviors>
        <interactivity:EventTriggerBehavior EventName="Loaded">
            <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
        </interactivity:EventTriggerBehavior>
        <interactivity:EventTriggerBehavior EventName="Unloaded">
            <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.UnLoadCommand}" />
        </interactivity:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <Page.Resources>
        <x:Double x:Key="MainColumnMinWidth">300</x:Double>
        <x:Double x:Key="StatColumnMaxWidth">160</x:Double>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Padding="24,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="4"
                           Foreground="{StaticResource GPForegroundColor2}"
                           FontSize="24"
                           FontFamily="{StaticResource KanitFontFamily}"
                           FontWeight="Bold">
                    <!--<Run Text="{x:Bind ViewModel.Head.EventTvName, Mode=OneWay}" />
                    <Run Text="{x:Bind ViewModel.Head.Remaining, Mode=OneWay}" />
                    <Run Text="{x:Bind ViewModel.Head.SessionStatusName, Mode=OneWay}" />
                    <Run Text="{x:Bind ViewModel.Head.Category, Mode=OneWay}" />-->
                </TextBlock>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
				  ItemsSource="{x:Bind ViewModel.Classifications, Mode=OneWay}"
                  ItemContainerStyleSelector="{StaticResource GPAlternateBackgroundListViewStyleSelector}">

            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="P"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}" />

                        <Grid Grid.Column="1"
                              Padding="8,0,16,0">
                            <TextBlock Text="NAME"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       TextAlignment="Left" />
                            <TextBlock Text="#"
                                       Style="{StaticResource GPDataGridHeaderTextBlock}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="TeamName" />

                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="Country" />

                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource GPDataGridHeaderTextBlock}"
                                   Text="Points" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
				<DataTemplate x:DataType="models:Classification">
                    <Grid MinHeight="48">

                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition MinWidth="{StaticResource MainColumnMinWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                            <ColumnDefinition MaxWidth="{StaticResource StatColumnMaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource GPBackgroundColor1}"
                                Margin="4"
                                CornerRadius="8"
                                Width="32"
                                Height="32">
                            <TextBlock TextAlignment="Center"
                                       Foreground="{ThemeResource GPForegroundColor4}"
                                       FontWeight="Bold"
                                       Text="{x:Bind Position}" />
                        </Border>

                        <Grid Grid.Column="1"
                              Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Height="Auto"
                                  Width="4"
                                  Margin="0,8,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Rectangle Fill="Gray" />
                                <Rectangle Grid.Row="1"
                                           Fill="LightGray" />
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource GPSubtitleTextBlock}"
									   Text="{x:Bind Rider.FullName}" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Padding="2">
                                <Border MinWidth="32"
                                        Height="32"
                                        Background="#25000000"
                                        VerticalAlignment="Center"
                                        CornerRadius="2">
									<TextBlock Text="{x:Bind Rider.Number}"
                                               Style="{StaticResource GPDataGridStatTextBlock}"
                                               Foreground="{ThemeResource GPForegroundColor3}"
                                               FontSize="18"
                                               TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource GPSubtitleTextBlock}"
                                   Text="{x:Bind TeamName}" />

                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource GPSubtitleTextBlock}"
								   Text="{x:Bind Rider.Country}" />

                        <TextBlock Grid.Column="4"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource GPSubtitleTextBlock}"
                                   Text="{x:Bind Points}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>