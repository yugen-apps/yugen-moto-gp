<Window x:Class="Yugen.MotoGP.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Yugen.MotoGP.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Yugen.MotoGP.App.Models"
        mc:Ignorable="d">

    <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.RiderCollection, Mode=OneWay}">
            <ListView.HeaderTemplate>
                <DataTemplate x:DataType="models:Rider">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Padding="2"
                                   Text="Pos" />

                        <TextBlock Grid.Column="1"
                                   Padding="2"
                                   Text="Name" />

                        <TextBlock Grid.Column="2"
                                   Padding="2"
                                   Text="Surname" />

                        <TextBlock Grid.Column="3"
                                   Padding="2"
                                   Text="Number" />

                        <TextBlock Grid.Column="4"
                                   Padding="2"
                                   Text="Lap Time" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Rider">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Padding="2"
                                   Text="{x:Bind pos}" />

                        <TextBlock Grid.Column="1"
                                   Padding="2"
                                   Text="{x:Bind rider_name}" />

                        <TextBlock Grid.Column="2"
                                   Padding="2"
                                   Text="{x:Bind rider_surname}" />

                        <TextBlock Grid.Column="3"
                                   Padding="2"
                                   Text="{x:Bind rider_number}" />

                        <TextBlock Grid.Column="4"
                                   Padding="2"
                                   Text="{x:Bind lap_time}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
